#!/usr/bin/env python3
"""kiosk-config: switch a kiosk's pages and transitions on and off.

  deploy/kiosk-config                                   what's on and off
  deploy/kiosk-config page off radar nowplaying         pages: on or off
  deploy/kiosk-config transition off matrix hackerman  transitions: on or off
  deploy/kiosk-config --check                           self-test

It writes the kiosk's own settings in ~/.config/kiosk/ (playlist.json, and transitions-off.json), which updates leave
alone, then restarts the display. The playlist starts as a copy of the repo's. KIOSK_HOSTS names every machine to
change, separated by spaces: the render server and its Pi both need them, because the server picks the transitions
and the Pi picks its own when it draws by itself. It defaults to KIOSK_HOST, then kiosk@kiosk.local.
"""
import json, os, subprocess, sys

HOSTS = (os.environ.get("KIOSK_HOSTS") or os.environ.get("KIOSK_HOST") or "kiosk@kiosk.local").split()
HERE = os.path.dirname(os.path.abspath(__file__))
REPO_PLAYLIST = os.path.join(HERE, "..", "kiosk", "playlist.json")
sys.path.insert(0, os.path.join(HERE, "..", "kiosk"))
import transitions  # noqa: E402
TRANSITIONS = list(transitions.THEMES)
PLAYLIST, OFF = ".config/kiosk/playlist.json", ".config/kiosk/transitions-off.json"


def ssh(host, cmd, stdin=None):
    return subprocess.run(["ssh", host, cmd], input=stdin, capture_output=True, text=True, check=True).stdout


def get(host, path, default):
    try:
        return json.loads(ssh(host, f"cat ~/{path}"))
    except subprocess.CalledProcessError:
        return default


def put(host, path, value):
    ssh(host, f"mkdir -p ~/.config/kiosk && cat > ~/{path}.tmp && mv ~/{path}.tmp ~/{path}", json.dumps(value, indent=1) + "\n")


def toggle(playlist, off, kind, on, names):
    """the new (playlist, off) with names switched on or off; raises ValueError for a name it doesn't know"""
    if kind == "page":
        known = {e["page"] for e in playlist}
        if set(names) - known:
            raise ValueError(f"no such page in the playlist: {', '.join(sorted(set(names) - known))}")
        playlist = [{**e, "on": on} if e["page"] in names else e for e in playlist]
        return [{k: v for k, v in e.items() if not (k == "on" and v)} for e in playlist], off
    if set(names) - set(TRANSITIONS):
        raise ValueError(f"no such transition: {', '.join(sorted(set(names) - set(TRANSITIONS)))}")
    return playlist, sorted(set(off) - set(names) if on else set(off) | set(names))


def show(playlist, off):
    print("pages:       " + "  ".join(f"{e['page']}{'' if e.get('on', True) else ' (off)'}" for e in playlist))
    print("transitions: " + "  ".join(f"{t}{' (off)' if t in off else ''}" for t in TRANSITIONS))


def check():
    pl = [{"page": "weather"}, {"page": "radar", "options": {"lat": 1}}]
    pl2, off = toggle(pl, [], "page", False, ["radar"])
    assert pl2[1] == {"page": "radar", "options": {"lat": 1}, "on": False} and off == []
    assert toggle(pl2, [], "page", True, ["radar"])[0] == pl, "switching it back on leaves no trace"
    assert toggle(pl, ["matrix"], "transition", False, ["hackerman", "matrix"])[1] == ["hackerman", "matrix"]
    assert toggle(pl, ["matrix", "hackerman"], "transition", True, ["matrix"])[1] == ["hackerman"]
    for bad in (("page", ["nope"]), ("transition", ["nope"])):
        try:
            toggle(pl, [], bad[0], False, bad[1]); raise AssertionError(bad)
        except ValueError:
            pass
    print("kiosk-config: ok")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--check"]:
        sys.exit(check())
    first = HOSTS[0]
    playlist, off = get(first, PLAYLIST, None) or json.load(open(REPO_PLAYLIST)), get(first, OFF, [])
    if not args:
        sys.exit(show(playlist, off))
    if len(args) < 3 or args[0] not in ("page", "transition") or args[1] not in ("on", "off"):
        sys.exit(__doc__)
    try:
        playlist, off = toggle(playlist, off, args[0], args[1] == "on", args[2:])
    except ValueError as e:
        sys.exit(str(e))
    for host in HOSTS:
        put(host, PLAYLIST, playlist); put(host, OFF, off)
        ssh(host, 'pkill -f "python3 -I /home/kiosk/kiosk/[k]iosk.py" || true')   # [k]: not this ssh's own shell; the Pi's login and systemd bring it back in 3 s
        print(f"{host}: done")
    show(playlist, off)
